# Environment
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/musicsportsapp

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JioSaavn Vercel proxy — must match PROXY_API_KEY on the Vercel side
JIOSAAVN_PROXY_KEY=
